module "use client";
import { useLayoutEffect, useRef, useState } from "octane";
import { Icon, type IconName } from "@/lib/icons";
import type { ReactElement } from "octane";
import {navGroups, NavGroup, NavItem} from '@/lib/navs'
import { Link } from '@octanejs/tanstack-router';
import { cn } from '@/lib/utils';

module
  // interface BranchedMenuChild {
  //   ~ value: string;
  //   ~ label: string;
  //   ~ icon?: IconName | ReactElement;
  //   ~ disabled?: boolean
  //   ~ }
  // export interface BranchedMenuItem {
  //   ~ label: string;
  //   ~ value?: string;
  //   ~ children?: BranchedMenuChild[];
  //   ~ }
  interface BranchedMenuProps {
    ~ items?: NavGroup[];
    ~ defaultOpen?: number | number[];
    ~ defaultActive?: string;
    ~ active?: string;
    ~ onSelect?: (value: string, item: NavItem | NavGroup) => void;
    ~ onToggle?: (index: number, open: boolean) => void;
    ~ color?: string;
    ~ accentColor?: string;
    ~ lineColor?: string;
    ~ width?: number;
    ~ rowHeight?: number;
    ~ indent?: number;
    ~ trunk?: number;
    ~ radius?: number;
    ~ lineWidth?: number;
    ~ fontSize?: number;
    ~ drawDuration?: number;
    ~ foldDuration?: number;
    ~ className?: string;
    ~ }
  const PAD = 6;
  const MARK = 16;
  const toSet = (open: number | number[]) => new Set(Array.isArray(open) ? open : open >= 0 ? [open] : []);

props { items = navGroups, defaultOpen = 0, defaultActive, active: controlledActive, onSelect, onToggle, color = "currentColor", accentColor = "currentColor", lineColor = "currentColor", width = 240, rowHeight = 32, indent = 40, trunk = 18, radius = 10, lineWidth = 1.5, fontSize = 14, drawDuration = 400, foldDuration = 300, className }: BranchedMenuProps
setup
  const [open, setOpen] = useState<Set<number>>(() => toSet(defaultOpen));

  const [activeValue, setActive] = useState(() => {
    if (defaultActive)
      return defaultActive;
    const first = items.find((it, i) => it.items && toSet(defaultOpen).has(i));
    return first?.items?.[0]?.value ?? "";
  });
  const active = controlledActive ?? activeValue;

  const navRef = useRef<HTMLElement | null>(null);
  const heads = useRef<(HTMLButtonElement | null)[]>([]);
  const markerRef = useRef<HTMLSpanElement | null>(null);

  const latest = useRef<{
    onSelect?: BranchedMenuProps["onSelect"];
    onToggle?: BranchedMenuProps["onToggle"];
  }>({});

  latest.current = { onSelect, onToggle };
  const activeSection = items.findIndex(it => it.items?.some(kid => kid.value === active));
  const markerShown = activeSection >= 0 && open.has(activeSection);

  useLayoutEffect(() => {
    const place = (glide: boolean) => {
      const m = markerRef.current;
      const el = heads.current[activeSection];
      if (!m)
        return;
      const on = markerShown && el;
      if (!glide)
        m.style.transition = "none";
      if (on)
        m.style.top = `${el.offsetTop + (el.offsetHeight - MARK) / 2}px`;
      m.toggleAttribute("data-on", Boolean(on));
      if (!glide) {
        void m.offsetHeight;
        m.style.transition = "";
      }
    };
    place(true);
    let first = true;
    const ro = new ResizeObserver(() => {
      if (first) {
        first = false;
        return;
      }
      place(false);
    });
    if (navRef.current)
      ro.observe(navRef.current);
    return () => ro.disconnect();
  }, [activeSection, markerShown, items, fontSize, rowHeight]);

  const select = (value: string, item: NavItem | NavGroup ) => {
    setActive(value);
    latest.current.onSelect?.(value, item);
  };

  const toggle = (i: number) => {
    const isOpen = !open.has(i);
    setOpen(prev => {
      const next = new Set(prev);
      if (!next.has(i))
        next.add(i);
      else
        next.delete(i);
      return next;
    });
    latest.current.onToggle?.(i, isOpen);
  };

  const r = Math.min(radius, rowHeight / 2 - 2);
  const endX = indent - 8;
  const rowY = (k: number) => PAD + k * rowHeight + rowHeight / 2;
  const branch = (k: number) => `M ${trunk} ${rowY(k) - r} A ${r} ${r} 0 0 0 ${trunk + r} ${rowY(k)} H ${endX}`;
  const reach = (k: number) => `M ${trunk} 0 V ${rowY(k) - r} A ${r} ${r} 0 0 0 ${trunk + r} ${rowY(k)} H ${endX}`;
  const length = (k: number) => rowY(k) - r + (Math.PI * r) / 2 + (endX - trunk - r);
nav(
  ~ ref={navRef}
  ~ className={`relative flex w-full max-w-[min(var(--bm-w),100%)] flex-col pl-3.5 leading-[1.3] [color:var(--bm-ink)] [font-family:inherit] [font-size:var(--bm-font)] before:absolute before:top-2 before:bottom-0 before:left-0 before:w-0.5 before:rounded-[1px] before:[background:linear-gradient(to_bottom,var(--bm-line)_0%,var(--bm-line)_50%,transparent_100%)] before:content-['']${className ? ` ${className}` : ""}`}
  ~ style={{
  ~ "--bm-w": `${width}px`,
  ~ "--bm-ink": color,
  ~ "--bm-accent": accentColor,
  ~ "--bm-focus": 'var(--focus)',
  ~ "--bm-line": lineColor,
  ~ "--bm-font": `${fontSize}px`,
  ~ "--bm-row": `${rowHeight}px`,
  ~ "--bm-indent": `${indent}px`,
  ~ "--bm-line-w": lineWidth,
  ~ "--bm-draw": `${drawDuration}ms`,
  ~ "--bm-muted": `color-mix(in srgb, ${color} 50%, transparent)`,
  ~ "--bm-fold": `${foldDuration}ms`
  ~ }}
  ~ )
  span(
    ~ className={cn("absolute top-px left-0 z-[1] h-4.25 w-0.5 rounded-[1px] opacity-20 [background:var(--bm-accent)] [transition:top_220ms_cubic-bezier(0.23,1,0.32,1),opacity_150ms_ease] data-[on]:opacity-100 motion-reduce:[transition:opacity_150ms_ease] pointer-events-none select-none", {'opacity-100': markerShown})}
    ~ ref={markerRef}
    ~ aria-hidden="true"
    ~ )
  each item, i in items key item.title
    div(className="group/section flex flex-col" data-open={item.items && open.has(i) ? "" : undefined})
      button(
        ~ className=" flex cursor-pointer border-0 bg-transparent gap-2 -ms-2.25 ps-2 py-1.5 text-left font-medium tracking-tight outline-none focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-[var(--bm-focus)] [color:var(--bm-muted)] [font-family:inherit] [font-size:calc(var(--bm-font)+1px)] [-webkit-tap-highlight-color:transparent] [transition:color_200ms_ease] group-data-[open]/section:[color:var(--bm-ink)] data-[active]:[color:var(--bm-ink)] hover:[color:var(--bm-ink)] select-none"
        ~ ref={el => {
        ~   heads.current[i] = el;
        ~   }}
        ~ type="button"
        ~ aria-expanded={item.items ? open.has(i) : undefined}
        ~ aria-current={!item.items && (item.title ?? item.label) === active ? "true" : undefined}
        ~ data-active={!item.items && (item.title ?? item.label) === active ? "" : undefined}
        ~ onClick={() => (item.items ? toggle(i) : select(item.title ?? item.label, item))}
        ~ )
        span #{item.title}
        Icon(name='chevron-down' size={12} className={cn('-rotate-90 opacity-50', {'rotate-0': item.items && open.has(i)})})

      if item.items
        div(className="grid [grid-template-rows:0fr] [transition:grid-template-rows_var(--bm-fold)_cubic-bezier(0.23,1,0.32,1)] group-data-[open]/section:[grid-template-rows:1fr] motion-reduce:transition-none" aria-hidden={!open.has(i)})
          div(className="min-h-0 overflow-hidden")
            div(className="relative px-1 box-border py-1.5" style={{ height: PAD * 2 + item.items.length * rowHeight }})
              svg(
                ~ className="pointer-events-none absolute top-0 left-0 overflow-visible opacity-0 [transition:opacity_200ms_ease] group-data-[open]/section:opacity-100 group-data-[open]/section:[transition:opacity_250ms_ease_100ms]"
                ~ width={indent}
                ~ height={PAD * 2 + item.items.length * rowHeight}
                ~ aria-hidden="true"
                ~ )
                if item.items.length > 0
                  path(
                    ~ className="fill-none [stroke:var(--bm-line)] [stroke-width:var(--bm-line-w)] [stroke-linecap:round] [stroke-linejoin:round]"
                    ~ d={`M ${trunk} 0 V ${rowY(item.items.length - 1) - r}`}
                    ~ )
                each kid, k in item.items key kid.value
                  path(
                    ~ className="fill-none [stroke:var(--bm-line)] [stroke-width:var(--bm-line-w)] [stroke-linecap:round] [stroke-linejoin:round]"
                    ~ d={branch(k)}
                    ~ )
                each kid, k in item.items key kid.value
                  path(
                    ~ className="fill-none [stroke:var(--bm-accent)] [stroke-width:var(--bm-line-w)] [stroke-linecap:round] [stroke-linejoin:round] [transition:stroke-dashoffset_var(--bm-draw)_cubic-bezier(0.23,1,0.32,1)] motion-reduce:transition-none"
                    ~ d={reach(k)}
                    ~ style={{
                    ~ strokeDasharray: length(k),
                    ~ strokeDashoffset: kid.value === active ? 0 : length(k)
                    ~ }}
                    ~ )
              each kid in item.items key kid.value
                Link(
                  ~ className="m-0 box-border flex w-full cursor-pointer items-center gap-1 border-0 bg-transparent py-0 pr-0 text-left tracking-tight outline-none focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-[var(--bm-focus)] [height:var(--bm-row)] [padding-left:var(--bm-indent)] [color:var(--bm-muted)] [font-family:inherit] [-webkit-tap-highlight-color:transparent] [transition:color_200ms_ease] hover:[color:var(--bm-ink)] disabled:hover:[color:var(--bm-muted)] disabled:opacity-50 font-medium data-[active]:[color:var(--bm-accent)]"
                  ~ to={kid.href}
                  ~ aria-current={kid.value === active ? "true" : undefined}
                  ~ data-active={kid.value === active ? "" : undefined}
                  ~ tabIndex={open.has(i) ? 0 : -1}
                  ~ onClick={() => select(kid.value, kid)}
                  ~ disabled={kid.disabled}
                  ~ )
                  if kid.icon
                    span(className="inline-flex flex-none" aria-hidden="true")
                      if typeof kid.icon === "string"
                        Icon(name={kid.icon} size={18} className='-ml-0.5 -mt-px')
                      else
                        | #{kid.icon}
                  span.whitespace-nowrap #{kid.label}
