import { cn } from "@/lib/utils"
import { Icon } from '@/lib/icons';
import Button from "./ui/Button.btsx";
import { ThemeToggle } from "./Theme.btsx";

module
  interface TopbarProps {
      toggleSidebar: VoidFunction
      isCompact?: boolean
    }
  export interface BrandProps {
    imageUrl?: string
    imageAlt?: string
    className?: string
    children?: unknown
  }

component Brand
  props { imageUrl, imageAlt = "Web App", className, children }: BrandProps
  setup
    const BRAND_CLASS = "flex items-center gap-3"
    const BRAND_IMAGE_CLASS = "size-16"


  div(className={cn(BRAND_CLASS, className)})
    a(className="flex items-center gap-4" href="/") App
      div #{children}


props { toggleSidebar, isCompact = false }: TopbarProps
header(className="sticky top-0 z-40 backdrop-blur-3xl border-b border-border/40 w-full")
  div(className="topbar w-full px-5 flex items-center justify-between gap-4")
    Brand
      div(className="hidden md:flex items-center")
        button(className="size-6 aspect-square rounded-none rounded-s-md border border-r-0 border-input grid place-items-center text-input hover:text-foreground hover:border-input transition" onClick={toggleSidebar} aria-label={isCompact ? "Expand sidebar" : "Compact sidebar"} aria-pressed={isCompact} title={isCompact ? "Expand sidebar" : "Compact sidebar"})
          Icon(name={isCompact ? "arrow-right" : "arrow-left"} className="" size={14})
        button(className="size-6 aspect-square rounded-none rounded-e-md border border-input grid place-items-center text-input hover:text-foreground hover:border-input transition" onClick={undefined} aria-label="Close sidebar")
          Icon(name="close-small" className="" size={14})
    div(className="flex items-center gap-2")
      ThemeToggle
      Button(label="Docs" variant='dark' size="sm" type='a' href='https://beast-docs.vercel.app' target="_blank" rel="noopener noreferrer" className="hidden md:flex")
