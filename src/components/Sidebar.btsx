import { cn } from "@/lib/utils"
import {Icon, type IconName} from "@/lib/icons"
import { navGroups } from "@/lib/navs"
import { Link } from "@octanejs/tanstack-router"
import { createElement, useRef, useLayoutEffect } from "octane"
import FluidTooltip, { FluidTooltipContent, FluidTooltipRoot, FluidTooltipTrigger } from "@/components/ui/FluidTooltip.btsx"

module
  export interface SidebarProps {
  }

  export interface SidebarItemProps {
    href: string
    icon: IconName
    label: string
    value?: string | number
    path?: string
    onHover?: (event: MouseEvent) => void
    isCompact?: boolean
    // onNavigate: (to: string) => (event: MouseEvent) => void
  }

  const SIDEBAR_CLASS = "hidden md:flex flex-col w-full h-[calc(100dvh-var(--topbar-height))] border-t border-sidebar-border overflow-hidden"
  const SIDEBAR_ITEM_CLASS = "relative z-10 flex w-full items-center gap-1.75 rounded-[12px] border py-1.75 pl-1.75 text-left"
  const SIDEBAR_ITEM_SELECTED_CLASS = "bg-[linear-gradient(in_oklab_180deg,oklab(95.2%_0_0)_0%,oklab(91.3%_0_0)_100%)] shadow-[inset_0_1px_0_#FFFFFF54,0_2.5px_3.5px_-1px_#00000026,0_0_0_1px_#D4D4D4] bg-origin-border dark:bg-[linear-gradient(in_oklab_180deg,oklab(32%_0_0)_0%,oklab(25%_0_0)_100%)] dark:shadow-[inset_0_1px_0_#FFFFFF10,0_3px_3px_-1px_#00000026,0_0_0_1px_#04040460] border-border/0"
  const SIDEBAR_ITEM_DEFAULT_CLASS = "border-transparent bg-transparent"
  const SIDEBAR_ICON_CONTAINER_CLASS = "flex size-7.5 shrink-0 items-center justify-center rounded-[8px] bg-transparent"
  const SIDEBAR_ICON_SELECTED_CONTAINER_CLASS = "flex size-7.5 shrink-0 items-center justify-center rounded-[8px] light:bg-background"
  const SIDEBAR_ICON_CLASS = "m-0 text-muted-foreground/90"
  const SIDEBAR_LABEL_CLASS = "flex-1 font-sans font-medium text-foreground/70 text-base leading-5 tracking-[-0.32px] truncate"
  const SIDEBAR_VALUE_CLASS = "ml-auto shrink-0 text-right font-mono text-2xs leading-none tabular-nums text-muted-foreground"
  const SIDEBAR_SELECTED_TEXT_CLASS = "text-primary"
  const SIDEBAR_ITEM_COMPACT_CLASS = "justify-center gap-0 p-1"

  export { SidebarNav }

component SidebarItem
  props { href, icon, label, path, isCompact = false, onHover }: SidebarItemProps
  setup
    const isExternal = href.startsWith("http")
    const isSelected = path === href
    const itemClassName = cn(SIDEBAR_ITEM_CLASS, isSelected ? SIDEBAR_ITEM_SELECTED_CLASS : SIDEBAR_ITEM_DEFAULT_CLASS, isCompact && SIDEBAR_ITEM_COMPACT_CLASS)
    const labelClassName = cn(SIDEBAR_LABEL_CLASS, isSelected && SIDEBAR_SELECTED_TEXT_CLASS)
    const iconClassName = cn(SIDEBAR_ICON_CLASS, isSelected && SIDEBAR_SELECTED_TEXT_CLASS)
    const iconContainerClassName = isSelected ? cn(SIDEBAR_ICON_SELECTED_CONTAINER_CLASS, isCompact && "bg-transparent dark:bg-transparent shadow-none") : SIDEBAR_ICON_CONTAINER_CLASS
    const compactLink = isCompact
      ? isExternal
        ? createElement("a", { href, className: itemClassName, target: "_blank", rel: "noopener noreferrer", onMouseEnter: onHover })
        : createElement(Link, { to: href, className: itemClassName, "aria-current": isSelected ? "page" : undefined, onMouseEnter: onHover })
      : undefined

  if isCompact
    FluidTooltipRoot(id={href} side="right" sideOffset={12})
      FluidTooltipTrigger(render={compactLink})
        fragment
          div(className={iconContainerClassName})
            Icon(name={icon} size={18} className={iconClassName})
          span(className="sr-only") #{label}
      FluidTooltipContent #{label}
  else
    if isExternal
      a(href={href} className={itemClassName} target="_blank" rel="noopener noreferrer" onMouseEnter={onHover})
        div(className={iconContainerClassName})
          Icon(name={icon} size={18} className={iconClassName})
        span(className={labelClassName}) #{label}
    else
      Link(to={href} className={itemClassName} aria-current={isSelected ? "page" : undefined} onMouseEnter={onHover})
        div(className={iconContainerClassName})
          Icon(name={icon} size={18} className={iconClassName})
        span(className={labelClassName}) #{label}


component SidebarNav
  props { path, className, isCompact = false }: { path: string; className?: string; isCompact?: boolean }
  setup
    const navlistRef = useRef<HTMLDivElement | null>(null)
    const hoveredItemRef = useRef<HTMLElement | null>(null)

    const updateIndicator = () => {
      const navlist = navlistRef.current
      const item = hoveredItemRef.current
      if (!navlist || !item) return

      const containerRect = navlist.getBoundingClientRect()
      const itemRect = item.getBoundingClientRect()
      navlist.style.setProperty('--hovered-nav-top', `${itemRect.top - containerRect.top + navlist.scrollTop}px`)
      navlist.style.setProperty('--hovered-nav-left', `${itemRect.left - containerRect.left + navlist.scrollLeft}px`)
      navlist.style.setProperty('--hovered-nav-height', `${itemRect.height}px`)
      navlist.style.setProperty('--hovered-nav-width', `${itemRect.width}px`)
    }

    const handleHover = (event: MouseEvent) => {
      hoveredItemRef.current = event.currentTarget as HTMLElement
      updateIndicator()
      navlistRef.current?.style.setProperty('--hovered-nav-opacity', '1')
    }

    const clearHover = () => {
      hoveredItemRef.current = null
      navlistRef.current?.style.setProperty('--hovered-nav-opacity', '0')
    }

    useLayoutEffect(() => {
      const navlist = navlistRef.current
      if (!navlist) return
      const resizeObserver = new ResizeObserver(updateIndicator)
      resizeObserver.observe(navlist)
      return () => resizeObserver.disconnect()
    }, [])

  div(ref={navlistRef} className={cn("relative isolate mt-2 py-4 px-1 space-y-6", className)} onMouseLeave={clearHover})
    each group in navGroups
      div(key={group.title})
        if isCompact
          div(className="mx-1 mb-2 h-0 bg-border/60" role="presentation")
        else
          div(className="font-medium text-xs tracking-wider opacity-50 uppercase ps-4 mb-1") #{group.title}
        nav(className="space-y-1 px-1 py-2 relative " aria-label={group.title})
          each item in group.items key item.href
            SidebarItem({...item} path={path} isCompact={isCompact} onHover={handleHover})
    div(
      ~ aria-hidden='true'
      ~ className='pointer-events-none absolute top-0 left-0 z-0 m-0! rounded-[12px] bg-sidebar-border/40 transition-[transform,width,height,opacity] duration-200 ease-out motion-reduce:transition-none shadow-none'
      ~ style={{ width: 'var(--hovered-nav-width, 0px)', height: 'var(--hovered-nav-height, 0px)', opacity: 'var(--hovered-nav-opacity, 0)', transform: 'translate3d(var(--hovered-nav-left, 0px), var(--hovered-nav-top, 0px), 0)' }}
      ~ )

component SidebarNavTooltips
  props { path, className, isCompact = false }: { path: string; className?: string; isCompact?: boolean }
  if isCompact
    FluidTooltip(orientation="vertical")
      SidebarNav(path={path} className={className} isCompact)
  else
    SidebarNav(path={path} className={className})

props { path, isCompact = false }: { path: string; isCompact?: boolean }
aside(className={SIDEBAR_CLASS} data-compact={isCompact || undefined})
  SidebarNavTooltips(path={path} isCompact={isCompact} className="flex-1 min-h-0 overflow-y-auto overflow-x-hidden")

  div(className=" shrink-0")
    div(className={cn("flex items-center h-10 gap-2 px-2-xs bg-background invert", isCompact && "justify-center")})
      div(className="flex-1 min-w-0")
        div(className="text-xs font-medium text-foreground leading-none")
        div(className={cn("text-2xs font-mono text-muted-foreground px-4", isCompact && "text-center")}) v0.2.62
